---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site.config';
const { url, anonKey } = siteConfig.integrations.supabase;
---

<BaseLayout title="Documentación técnica" description="Documentación técnica de tu instalación eléctrica." noindex={true}>
  <main id="main-content" class="min-h-[70vh] bg-neutral-50">
    <div class="max-w-2xl mx-auto px-4 py-10">
      <div class="flex items-center gap-2 mb-6">
        <span class="grid place-items-center size-9 rounded-lg bg-primary-700 text-white font-bold text-sm">MP</span>
        <div>
          <p class="font-semibold text-neutral-900 leading-tight">IntegracionMP</p>
          <p class="text-xs text-neutral-500">Electricidad / Obra civil / S&amp;H</p>
        </div>
      </div>

      <div id="estado" class="text-neutral-500 text-sm py-10 text-center">Cargando documentación…</div>

      <div id="contenido" class="hidden">
        <h1 id="titulo" class="text-2xl font-bold text-neutral-900"></h1>
        <p id="subtitulo" class="text-sm text-neutral-500 mb-6"></p>
        <div id="tableros" class="space-y-4 mb-8"></div>
        <ul id="docs" class="space-y-2 mb-8"></ul>

        <div class="border-t border-neutral-200 pt-6">
          <button id="btn-qr" class="text-sm font-medium text-primary-700 border border-primary-200 hover:bg-primary-50 rounded-lg px-4 py-2">
            Ver QR para imprimir
          </button>
          <div id="qr-box" class="hidden mt-5 text-center">
            <div id="qr" class="inline-block bg-white p-4 rounded-xl ring-1 ring-neutral-200"></div>
            <p class="text-xs text-neutral-500 mt-2">Escaneá para abrir esta página. Pegalo en el tablero.</p>
            <button id="btn-print" class="mt-3 text-sm font-medium text-white bg-primary-700 hover:bg-primary-800 rounded-lg px-4 py-2">
              Imprimir QR
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Visor del tablero a pantalla completa -->
  <div id="tablero-viewer" class="hidden fixed inset-0 z-[60] bg-white overflow-auto">
    <div class="sticky top-0 bg-white/95 backdrop-blur border-b border-neutral-200 z-10">
      <div class="flex items-center gap-3 px-4 py-3">
        <button id="tablero-viewer-cerrar" class="inline-flex items-center gap-1.5 text-sm font-semibold text-white bg-primary-700 hover:bg-primary-800 rounded-lg px-3 py-2 shrink-0">
          <span aria-hidden="true">←</span> Volver
        </button>
        <p id="tablero-viewer-titulo" class="font-semibold text-neutral-900 truncate"></p>
      </div>
      <div id="tablero-tabs" class="hidden gap-2 overflow-x-auto px-4 pb-2"></div>
    </div>
    <p class="text-xs text-neutral-500 px-4 py-2 max-w-2xl mx-auto">Tocá cada punto para ver qué circuito es. Hacé zoom con los dedos.</p>
    <div id="tablero-viewer-body" class="px-2 pb-12 max-w-2xl mx-auto"></div>
  </div>

  <!-- Popup al tocar un punto del tablero -->
  <div id="punto-modal" class="hidden fixed inset-0 z-[70] grid place-items-end sm:place-items-center">
    <div id="punto-fondo" class="absolute inset-0 bg-black/50"></div>
    <div class="relative bg-white w-full sm:max-w-sm rounded-t-2xl sm:rounded-2xl p-5 shadow-lift max-h-[85vh] overflow-y-auto">
      <p id="punto-titulo" class="text-lg font-bold text-neutral-900 mb-1"></p>
      <p id="punto-desc" class="text-sm font-medium text-neutral-700"></p>
      <div id="punto-detalle" class="hidden text-sm text-neutral-600 leading-relaxed whitespace-pre-line mt-2"></div>
      <a id="punto-enlace" class="hidden items-center justify-center gap-1.5 mt-3 w-full text-sm font-medium text-primary-700 border border-primary-200 hover:bg-primary-50 rounded-lg py-2.5" target="_blank" rel="noopener noreferrer">Ver más ↗</a>
      <button id="punto-cerrar" class="mt-3 w-full text-sm font-medium text-white bg-primary-700 hover:bg-primary-800 rounded-lg py-2.5">
        Cerrar
      </button>
    </div>
  </div>

  <!-- Solo se ve al imprimir: QR grande + título centrado abajo -->
  <div id="print-area" class="hidden">
    <div id="print-qr"></div>
    <p id="print-titulo"></p>
  </div>
</BaseLayout>

<script is:inline define:vars={{ supabaseUrl: url, supabaseKey: anonKey }}>
  document.body.classList.add('qr-page');
  const params = new URLSearchParams(location.search);
  const token = params.get('id');
  const estado = document.getElementById('estado');
  const contenido = document.getElementById('contenido');

  function tipoIcono() {
    return '📄';
  }

  async function cargar() {
    if (!token) {
      estado.textContent = 'Link inválido. Pedile a IntegracionMP el enlace correcto.';
      return;
    }
    try {
      const res = await fetch(`${supabaseUrl}/rest/v1/rpc/documentacion_qr`, {
        method: 'POST',
        headers: { apikey: supabaseKey, Authorization: `Bearer ${supabaseKey}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ p_token: token }),
      });
      const data = await res.json();
      if (!data || !data.titulo) {
        estado.textContent = 'No encontramos documentación para este link.';
        return;
      }
      document.getElementById('titulo').textContent = data.titulo;
      document.getElementById('subtitulo').textContent = data.cliente ? data.cliente : '';
      const docs = Array.isArray(data.docs) ? data.docs : [];
      const ul = document.getElementById('docs');
      if (docs.length === 0) {
        ul.innerHTML = '<li class="text-sm text-neutral-500">Todavía no hay documentos disponibles.</li>';
      } else {
        docs.forEach((d) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-3 bg-white border border-neutral-200 rounded-xl p-3';
          const info = document.createElement('div');
          info.className = 'min-w-0 flex-1';
          const t = document.createElement('p');
          t.className = 'text-sm font-medium text-neutral-900 truncate';
          t.textContent = d.descripcion || d.nombre || d.tipo || 'Documento';
          const s = document.createElement('p');
          s.className = 'text-xs text-neutral-500';
          s.textContent = d.tipo || '';
          info.appendChild(t);
          info.appendChild(s);
          const a = document.createElement('a');
          a.href = d.url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'text-sm font-medium text-primary-700 hover:underline shrink-0';
          a.textContent = 'Abrir';
          li.appendChild(info);
          li.appendChild(a);
          ul.appendChild(li);
        });
      }
      renderTableros(Array.isArray(data.tableros) ? data.tableros : []);
      estado.classList.add('hidden');
      contenido.classList.remove('hidden');
    } catch (e) {
      estado.textContent = 'Hubo un problema al cargar la documentación. Probá de nuevo.';
    }
  }

  let viewerTableros = [];

  function renderTableros(tableros) {
    const cont = document.getElementById('tableros');
    cont.innerHTML = '';
    const conFoto = tableros.filter((t) => t.imagen);
    if (conFoto.length === 0) return;
    const row = document.createElement('div');
    row.className = 'flex items-center gap-3 bg-white border border-neutral-200 rounded-xl p-3';
    const info = document.createElement('div');
    info.className = 'min-w-0 flex-1';
    const titulo = document.createElement('p');
    titulo.className = 'text-sm font-medium text-neutral-900 truncate';
    titulo.textContent = 'Tablero interactivo';
    const sub = document.createElement('p');
    sub.className = 'text-xs text-neutral-500';
    sub.textContent = conFoto.length > 1 ? `${conFoto.length} vistas · tocá para abrir` : 'Tocá para ver las térmicas';
    info.appendChild(titulo);
    info.appendChild(sub);
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'text-sm font-medium text-white bg-primary-700 hover:bg-primary-800 rounded-lg px-3 py-1.5 shrink-0';
    btn.textContent = 'Abrir';
    btn.addEventListener('click', () => openViewer(conFoto));
    row.appendChild(info);
    row.appendChild(btn);
    cont.appendChild(row);
  }

  function openViewer(tableros) {
    viewerTableros = tableros;
    const tabs = document.getElementById('tablero-tabs');
    tabs.innerHTML = '';
    if (tableros.length > 1) {
      tabs.classList.remove('hidden');
      tabs.classList.add('flex');
      tableros.forEach((t, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.i = String(i);
        b.textContent = t.nombre || 'Vista ' + (i + 1);
        b.addEventListener('click', () => selectTab(i));
        tabs.appendChild(b);
      });
    } else {
      tabs.classList.add('hidden');
      tabs.classList.remove('flex');
    }
    selectTab(0);
    document.getElementById('tablero-viewer').classList.remove('hidden');
  }

  function selectTab(i) {
    const activa = 'text-xs font-semibold text-white bg-primary-700 rounded-full px-3 py-1.5 shrink-0 whitespace-nowrap';
    const inactiva = 'text-xs font-medium text-neutral-600 bg-neutral-100 hover:bg-neutral-200 rounded-full px-3 py-1.5 shrink-0 whitespace-nowrap';
    document.querySelectorAll('#tablero-tabs button').forEach((b) => {
      b.className = Number(b.dataset.i) === i ? activa : inactiva;
    });
    renderBodyFor(viewerTableros[i]);
  }

  function renderBodyFor(t) {
    const body = document.getElementById('tablero-viewer-body');
    body.innerHTML = '';
    const wrap = document.createElement('div');
    wrap.className = 'relative w-full';
    const img = document.createElement('img');
    img.src = t.imagen;
    img.className = 'w-full block';
    wrap.appendChild(img);
    const puntos = Array.isArray(t.puntos) ? t.puntos : [];
    puntos.forEach((p, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'absolute -translate-x-1/2 -translate-y-1/2 size-7 rounded-full bg-primary-600 text-white text-xs font-bold grid place-items-center shadow ring-2 ring-white';
      dot.style.left = p.x + '%';
      dot.style.top = p.y + '%';
      dot.textContent = String(i + 1);
      dot.addEventListener('click', () => abrirPunto(i + 1, p));
      wrap.appendChild(dot);
    });
    body.appendChild(wrap);
  }

  // Convierte el texto en nodos, haciendo tocables los links (sin HTML inseguro)
  function linkificar(el, texto) {
    el.innerHTML = '';
    const re = /(https?:\/\/[^\s]+)/g;
    let last = 0;
    let m;
    while ((m = re.exec(texto)) !== null) {
      if (m.index > last) el.appendChild(document.createTextNode(texto.slice(last, m.index)));
      const a = document.createElement('a');
      a.href = m[0];
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.className = 'text-primary-700 underline break-all';
      a.textContent = m[0];
      el.appendChild(a);
      last = m.index + m[0].length;
    }
    if (last < texto.length) el.appendChild(document.createTextNode(texto.slice(last)));
  }

  function abrirPunto(num, p) {
    const modal = document.getElementById('punto-modal');
    document.getElementById('punto-titulo').textContent = p.titulo || ('Punto ' + num);
    const desc = document.getElementById('punto-desc');
    desc.textContent = p.descripcion || '';
    desc.style.display = p.descripcion ? '' : 'none';
    const det = document.getElementById('punto-detalle');
    if (p.detalle && p.detalle.trim()) {
      linkificar(det, p.detalle);
      det.classList.remove('hidden');
    } else {
      det.classList.add('hidden');
    }
    const link = document.getElementById('punto-enlace');
    if (p.enlace && p.enlace.trim()) {
      link.href = /^https?:\/\//.test(p.enlace) ? p.enlace : 'https://' + p.enlace;
      link.classList.remove('hidden');
      link.classList.add('flex');
    } else {
      link.classList.add('hidden');
      link.classList.remove('flex');
    }
    modal.classList.remove('hidden');
  }

  // QR: se genera con una librería liviana cargada desde CDN al tocar el botón
  let qrLibCargada = false;
  function cargarQrLib() {
    return new Promise((resolve, reject) => {
      if (qrLibCargada || window.QRCode) return resolve();
      const s = document.createElement('script');
      s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
      s.onload = () => { qrLibCargada = true; resolve(); };
      s.onerror = () => reject();
      document.head.appendChild(s);
    });
  }

  document.getElementById('btn-qr').addEventListener('click', async () => {
    const box = document.getElementById('qr-box');
    box.classList.toggle('hidden');
    const cont = document.getElementById('qr');
    if (!box.classList.contains('hidden') && cont.childElementCount === 0) {
      try {
        await cargarQrLib();
        new window.QRCode(cont, { text: location.href, width: 220, height: 220, correctLevel: window.QRCode.CorrectLevel.M });
      } catch {
        cont.innerHTML = '<p class="text-xs text-red-600">No se pudo generar el QR.</p>';
      }
    }
  });

  document.getElementById('btn-print').addEventListener('click', async () => {
    try {
      await cargarQrLib();
      const cont = document.getElementById('print-qr');
      cont.innerHTML = '';
      new window.QRCode(cont, { text: location.href, width: 320, height: 320, correctLevel: window.QRCode.CorrectLevel.M });
      document.getElementById('print-titulo').textContent = document.getElementById('titulo').textContent || '';
      // Pequeña espera para que el QR termine de dibujarse antes de abrir el diálogo
      setTimeout(() => window.print(), 150);
    } catch {
      window.print();
    }
  });

  (function () {
    const modal = document.getElementById('punto-modal');
    const cerrar = () => modal.classList.add('hidden');
    document.getElementById('punto-cerrar').addEventListener('click', cerrar);
    document.getElementById('punto-fondo').addEventListener('click', cerrar);
    const viewer = document.getElementById('tablero-viewer');
    document.getElementById('tablero-viewer-cerrar').addEventListener('click', () => viewer.classList.add('hidden'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        cerrar();
        viewer.classList.add('hidden');
      }
    });
  })();

  cargar();
</script>

<style is:global>
  @media print {
    @page { margin: 1.5cm; }
    /* Solo en esta página (body.qr-page): ocultamos todo el sitio… */
    body.qr-page > * { display: none !important; }
    /* …y mostramos solo el bloque de impresión */
    body.qr-page #print-area {
      display: flex !important;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      min-height: 90vh;
    }
    body.qr-page #print-titulo {
      font-size: 22px;
      font-weight: 700;
      text-align: center;
      max-width: 90%;
      color: #111;
    }
  }
</style>
